<?xml version="1.0" encoding="utf-8"?>
<!-- TextInputLayout outline: accent when focused, 3:1 outline at rest. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:color="@color/gh_accent" android:state_focused="true" />
    <item android:color="@color/gh_text_muted" android:state_hovered="true" />
    <item android:color="@color/gh_text_disabled" android:state_enabled="false" />
    <item android:color="@color/gh_outline" />
</selector>
