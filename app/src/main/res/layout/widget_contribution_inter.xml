<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Font variant of widget_contribution.xml (inter); keep ids in sync. -->
    <!-- Card background is a bitmap so opacity never fades the text. -->
    <ImageView
        android:id="@+id/widget_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <LinearLayout
            android:id="@+id/widget_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/widget_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@user"
                    style="@style/WidgetText.Title"
                    android:fontFamily="@font/inter" />

                <TextView
                    android:id="@+id/widget_subtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Loading…"
                    style="@style/WidgetText.Subtitle"
                    android:fontFamily="@font/inter" />
            </LinearLayout>

            <TextView
                android:id="@+id/widget_total"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="–"
                style="@style/WidgetText.Total"
                android:fontFamily="@font/inter" />

            <TextView
                android:id="@+id/widget_refresh"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:contentDescription="Refresh widget"
                android:gravity="center"
                android:text="⟳"
                android:textColor="#F0F6FC"
                android:textSize="20sp" />
        </LinearLayout>

        <ImageView
            android:id="@+id/widget_graph"
            android:layout_width="match_parent"
            android:layout_height="110dp"
            android:layout_marginTop="8dp"
            android:adjustViewBounds="true"
            android:contentDescription="Contribution graph"
            android:scaleType="fitCenter" />

        <TextView
            android:id="@+id/widget_updated"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Less                                      More"
            style="@style/WidgetText.Updated"
            android:fontFamily="@font/inter" />

    </LinearLayout>
</FrameLayout>
