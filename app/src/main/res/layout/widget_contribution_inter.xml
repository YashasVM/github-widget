<?xml version="1.0" encoding="utf-8"?>
<!--
    Font variant (inter) of widget_contribution.xml.
    All seven variants share ids, structure and styles (res/values/widget_text.xml);
    only android:fontFamily (and bold for single-weight faces) differs. Keep them in sync.
    The root is @android:id/background so Android 12+ launchers clip and animate it.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    style="@style/WidgetRoot">

    <!-- Card background is a bitmap so opacity never fades the text. -->
    <ImageView
        android:id="@+id/widget_bg"
        style="@style/WidgetBg" />

    <LinearLayout style="@style/WidgetContent">

        <LinearLayout style="@style/WidgetHeaderRow">

            <LinearLayout
                android:id="@+id/widget_header"
                style="@style/WidgetHeaderText">

                <TextView
                    android:id="@+id/widget_title"
                    style="@style/WidgetText.Title"
                    android:fontFamily="@font/inter" />

                <TextView
                    android:id="@+id/widget_subtitle"
                    style="@style/WidgetText.Subtitle"
                    android:fontFamily="@font/inter" />
            </LinearLayout>

            <TextView
                android:id="@+id/widget_total"
                style="@style/WidgetText.Total"
                android:fontFamily="@font/inter" />
        </LinearLayout>

        <ImageView
            android:id="@+id/widget_graph"
            style="@style/WidgetGraph" />

        <TextView
            android:id="@+id/widget_updated"
            style="@style/WidgetText.Updated"
            android:fontFamily="@font/inter" />
    </LinearLayout>

    <!-- Last child, so its 48dp corner target sits above everything else. -->
    <ImageView
        android:id="@+id/widget_refresh"
        style="@style/WidgetRefresh" />
</FrameLayout>
