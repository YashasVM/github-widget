<?xml version="1.0" encoding="utf-8"?>
<!--
    Drawing Studio: top bar with back, square canvas, tools (chips with icons),
    brush color / size, undo-redo-clear, and a bottom action bar that stays put.
    Edge-to-edge: DrawingActivity pads dr_appbar (status bar) and dr_bar
    (navigation bar). Everything wraps at 200% font; nothing has a fixed text height.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/dr_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/gh_bg"
    android:orientation="vertical">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/dr_appbar"
        style="@style/Widget.GH.AppBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/dr_toolbar"
            style="@style/Widget.GH.Toolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:title="Drawing Studio" />
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/dr_scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/gh_gutter"
            android:paddingEnd="@dimen/gh_gutter"
            android:paddingBottom="@dimen/gh_space_l">

            <TextView
                style="@style/Widget.GH.Text.Body.Muted"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/gh_space_m"
                android:text="Draw a background, then put it on your widget." />

            <!-- Height is set to the width in code (square, capped on short screens). -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/drawing_frame"
                style="@style/Widget.GH.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <com.example.githubwidget.DrawingView
                    android:id="@+id/drawing_canvas"
                    android:layout_width="match_parent"
                    android:layout_height="320dp"
                    android:contentDescription="Drawing canvas" />
            </com.google.android.material.card.MaterialCardView>

            <!-- ===== tool ===== -->
            <TextView
                style="@style/Widget.GH.Text.Section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/gh_space_l"
                android:text="Tool" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/drawing_tools"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/gh_space_xs"
                app:chipSpacingVertical="0dp"
                app:selectionRequired="true"
                app:singleSelection="true" />

            <!-- ===== brush: color, history ===== -->
            <TextView
                style="@style/Widget.GH.Text.Section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/gh_space_l"
                android:text="Brush" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/gh_space_s"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/drawing_color"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:contentDescription="Brush color"
                    android:text="" />

                <TextView
                    android:id="@+id/drawing_color_hex"
                    style="@style/Widget.GH.Text.Value"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/gh_space_m"
                    android:layout_weight="1"
                    android:importantForAccessibility="no"
                    android:textColor="@color/gh_text_muted" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/drawing_undo"
                    style="@style/Widget.GH.Button.Icon"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:contentDescription="Undo"
                    app:icon="@drawable/ic_ui_undo_24" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/drawing_redo"
                    style="@style/Widget.GH.Button.Icon"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:contentDescription="Redo"
                    app:icon="@drawable/ic_ui_redo_24" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/drawing_clear"
                    style="@style/Widget.GH.Button.Icon"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:contentDescription="Clear canvas"
                    app:icon="@drawable/ic_ui_delete_24" />
            </LinearLayout>

            <!-- ===== size ===== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/gh_space_m"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/Widget.GH.Text.Label"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:labelFor="@id/drawing_size"
                    android:text="Size" />

                <TextView
                    android:id="@+id/drawing_size_text"
                    style="@style/Widget.GH.Text.Value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:importantForAccessibility="no"
                    android:text="24px" />
            </LinearLayout>

            <com.google.android.material.slider.Slider
                android:id="@+id/drawing_size"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:contentDescription="Brush size"
                android:stepSize="2"
                android:value="24"
                android:valueFrom="4"
                android:valueTo="96" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- ===== sticky actions ===== -->
    <com.google.android.material.divider.MaterialDivider
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:dividerColor="@color/gh_outline_variant" />

    <LinearLayout
        android:id="@+id/dr_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/gh_surface"
        android:orientation="vertical"
        android:paddingStart="@dimen/gh_gutter"
        android:paddingTop="@dimen/gh_space_m"
        android:paddingEnd="@dimen/gh_gutter"
        android:paddingBottom="@dimen/gh_space_m">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/drawing_use_bg"
            style="@style/Widget.GH.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Use as widget background"
            app:icon="@drawable/ic_ui_image_24"
            app:iconGravity="textStart" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/gh_space_s"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/drawing_save"
                style="@style/Widget.GH.Button.Tonal"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="@dimen/gh_space_xs"
                android:layout_weight="1"
                android:text="Save PNG"
                app:icon="@drawable/ic_ui_download_24"
                app:iconGravity="textStart" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/drawing_share"
                style="@style/Widget.GH.Button.Tonal"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="@dimen/gh_space_xs"
                android:layout_weight="1"
                android:text="Share"
                app:icon="@drawable/ic_ui_share_24"
                app:iconGravity="textStart" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
