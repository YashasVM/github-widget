<?xml version="1.0" encoding="utf-8"?>
<!--
    Activity (analytics). Top bar with back, then either the empty state
    (an_empty: no username or no data yet) or the stats (an_content).
    Edge-to-edge: ActivityActivity pads an_appbar (status bar) and the root
    (navigation bar). Nothing has a fixed height, so 200% font wraps instead
    of clipping.
-->
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/an_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/gh_bg">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/an_appbar"
        style="@style/Widget.GH.AppBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/an_toolbar"
            style="@style/Widget.GH.Toolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:title="Activity" />
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/an_scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/gh_gutter"
            android:paddingEnd="@dimen/gh_gutter"
            android:paddingBottom="@dimen/gh_space_xl">

            <TextView
                android:id="@+id/an_title"
                style="@style/Widget.GH.Text.Display"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="2"
                android:text="Activity" />

            <TextView
                android:id="@+id/an_updated"
                style="@style/Widget.GH.Text.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="" />

            <!-- ===== Empty state: no username, or nothing cached yet ===== -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/an_empty"
                style="@style/Widget.GH.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/gh_space_l"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/gh_space_l">

                    <ImageView
                        android:id="@+id/an_empty_graph"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/gh_space_l"
                        android:adjustViewBounds="true"
                        android:alpha="0.7"
                        android:importantForAccessibility="no"
                        android:scaleType="fitCenter" />

                    <TextView
                        android:id="@+id/an_empty_title"
                        style="@style/Widget.GH.Text.Headline"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="No activity yet" />

                    <TextView
                        android:id="@+id/an_empty_body"
                        style="@style/Widget.GH.Text.Body.Muted"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/gh_space_s"
                        android:text="" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/an_empty_action"
                        style="@style/Widget.GH.Button.Primary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/gh_space_l"
                        android:text="Set up"
                        app:icon="@drawable/ic_ui_arrow_forward_24"
                        app:iconGravity="textEnd" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ===== Stats ===== -->
            <LinearLayout
                android:id="@+id/an_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

            <TextView
                style="@style/Widget.GH.Text.Section.Group"
                android:text="Last 12 months" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/an_total_tile"
                    style="@style/Widget.GH.Card"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:focusable="true">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/gh_space_m">

                        <TextView
                            android:id="@+id/an_total"
                            style="@style/Widget.GH.Text.Stat"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="–" />

                        <TextView
                            style="@style/Widget.GH.Text.Caption"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:hyphenationFrequency="full"
                            android:text="contributions" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/an_week_tile"
                    style="@style/Widget.GH.Card"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginStart="@dimen/gh_space_s"
                    android:focusable="true">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/gh_space_m">

                        <TextView
                            android:id="@+id/an_week"
                            style="@style/Widget.GH.Text.Stat"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="–" />

                        <TextView
                            style="@style/Widget.GH.Text.Caption"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="this week" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/gh_space_s"
                android:orientation="horizontal">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/an_month_tile"
                    style="@style/Widget.GH.Card"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:focusable="true">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/gh_space_m">

                        <TextView
                            android:id="@+id/an_month"
                            style="@style/Widget.GH.Text.Stat"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="–" />

                        <TextView
                            style="@style/Widget.GH.Text.Caption"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="this month" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/an_avg_tile"
                    style="@style/Widget.GH.Card"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginStart="@dimen/gh_space_s"
                    android:focusable="true">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/gh_space_m">

                        <TextView
                            android:id="@+id/an_avg"
                            style="@style/Widget.GH.Text.Stat"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="–" />

                        <TextView
                            style="@style/Widget.GH.Text.Caption"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="avg per active day" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/gh_space_s"
                android:orientation="horizontal">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/an_active_tile"
                    style="@style/Widget.GH.Card"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:focusable="true">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/gh_space_m">

                        <TextView
                            android:id="@+id/an_active"
                            style="@style/Widget.GH.Text.Stat"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="–" />

                        <TextView
                            style="@style/Widget.GH.Text.Caption"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="active days" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/an_best_tile"
                    style="@style/Widget.GH.Card"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginStart="@dimen/gh_space_s"
                    android:focusable="true">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/gh_space_m">

                        <TextView
                            android:id="@+id/an_best"
                            style="@style/Widget.GH.Text.Stat"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="–" />

                        <TextView
                            style="@style/Widget.GH.Text.Caption"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="best day" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <TextView
                style="@style/Widget.GH.Text.Section.Group"
                android:text="Streaks" />

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.GH.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/gh_space_l">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:focusable="true"
                        android:orientation="vertical">

                        <TextView
                            style="@style/Widget.GH.Text.Caption"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Current streak" />

                        <TextView
                            android:id="@+id/an_streak"
                            style="@style/Widget.GH.Text.Stat"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="–" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="@dimen/gh_space_l"
                        android:focusable="true"
                        android:orientation="vertical">

                        <TextView
                            style="@style/Widget.GH.Text.Caption"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Longest streak" />

                        <TextView
                            android:id="@+id/an_longest"
                            style="@style/Widget.GH.Text.Stat"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="–" />
                    </LinearLayout>
                    </LinearLayout>

                    <com.google.android.material.progressindicator.LinearProgressIndicator
                        android:id="@+id/an_milestone_bar"
                        style="@style/Widget.GH.Meter"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/gh_space_m"
                        android:importantForAccessibility="no"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/an_milestone"
                        style="@style/Widget.GH.Text.Body.Muted"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/gh_space_s"
                        android:text="" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                style="@style/Widget.GH.Text.Section.Group"
                android:text="Activity by weekday" />

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.GH.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:id="@+id/rows_weekday"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="@dimen/gh_space_l"
                    android:paddingTop="@dimen/gh_space_m"
                    android:paddingEnd="@dimen/gh_space_l"
                    android:paddingBottom="@dimen/gh_space_m" />
            </com.google.android.material.card.MaterialCardView>

            <TextView
                style="@style/Widget.GH.Text.Section.Group"
                android:text="Personal records" />

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.GH.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:id="@+id/rows_records"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="@dimen/gh_space_l"
                    android:paddingTop="@dimen/gh_space_m"
                    android:paddingEnd="@dimen/gh_space_l"
                    android:paddingBottom="@dimen/gh_space_m" />
            </com.google.android.material.card.MaterialCardView>

            <TextView
                style="@style/Widget.GH.Text.Section.Group"
                android:text="Insights" />

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.GH.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:id="@+id/rows_insights"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="@dimen/gh_space_l"
                    android:paddingTop="@dimen/gh_space_m"
                    android:paddingEnd="@dimen/gh_space_l"
                    android:paddingBottom="@dimen/gh_space_m" />
            </com.google.android.material.card.MaterialCardView>

            <TextView
                style="@style/Widget.GH.Text.Section.Group"
                android:text="Achievements" />

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.GH.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:id="@+id/rows_achievements"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="@dimen/gh_space_l"
                    android:paddingTop="@dimen/gh_space_m"
                    android:paddingEnd="@dimen/gh_space_l"
                    android:paddingBottom="@dimen/gh_space_m" />
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_share"
                style="@style/Widget.GH.Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/gh_space_xl"
                android:text="Share contribution card"
                app:icon="@drawable/ic_ui_share_24"
                app:iconGravity="textStart" />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
